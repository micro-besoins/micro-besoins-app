PORT=3000
# Adapter l'utilisateur, le mot de passe, le port et le nom de la base PostgreSQL.
DATABASE_URL=postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/microBesoins
# Générer un secret personnel avec la commande indiquée dans le README.
JWT_SECRET=VOTRE_SECRET_ALEATOIRE
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:4200
